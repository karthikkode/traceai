// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id             String   @id @default(uuid()) // Unique identifier
  ipAddress      String   // Visitor's IP address
  location  String?  // Location of the visitor (optional)
  elementId      String?  // Optional ID of the element involved
  elementContent String?   // Content of the element tracked
  traceEventName String?  // trace event name (name of the event in the tag)
  traceEvent     String?  // trace event type (eg: trace-click, trace-hover etc)
  url            String   // URL where the event occurred
  deviceType     String   // Device type (e.g., desktop, mobile, tablet)
  browser        String   // Browser information
  additionalData Json?    // Additional data in JSON format
  createdAt      DateTime @default(now())      // Timestamp when the event was created
  updatedAt      DateTime @updatedAt           // Timestamp when the event was last updated
}

model Trace {
  id             String         @id @default(uuid()) // Unique identifier
  name           String         // Name of the trace
  description    String?
  createdAt      DateTime       @default(now())      // Timestamp when the trace was created
  updatedAt      DateTime       @updatedAt           // Timestamp when the trace was last updated
  data           Json
  traceMetabaseCard Int?
}

model PaymentUrl {
  id             String   @id @default(uuid()) // Unique identifier
  url            String   // URL of the payment setup
  duration       Int      @default(60)         // Duration in minutes for tracking failures
  failureCount   Int      @default(0)          // Count of payment failures
  lastEmailSentAt DateTime?                    // Timestamp of the last email sent
  createdAt      DateTime @default(now())      // Timestamp when the URL was created
  updatedAt      DateTime @updatedAt           // Timestamp when the URL was last updated
}

model FormFieldInteraction {
  id             String   @id @default(uuid()) // Unique identifier
  form_id        String   // Unique identifier for the form
  field_name     String   // Name or ID of the field
  field_content  String   // Content entered by the user
  field_rank     Int      // Order of the field in the form
  createdAt      DateTime @default(now())      // Timestamp when the field was interacted with
  updatedAt      DateTime @updatedAt           // Timestamp when the field interaction was last updated
}